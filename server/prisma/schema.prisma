// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================  ENUMS  ================

/// System roles — controls access to every protected route via RBAC middleware.
/// Hierarchy : ADMIN (3) > MANAGER (2) > CASHIER (1)
enum Role {
  ADMIN
  MANAGER
  CASHIER
}

/// All payment methods accepted at the POS terminal.
enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
}

/// Lifecycle of a sale transaction.
enum SaleStatus {
  PENDING    // Cart open, not yet confirmed
  COMPLETED  // Payment accepted, inventory deducted
  VOIDED     // Cancelled before payment
  REFUNDED   // Post-completion reversal
}

/// Reason codes for manual inventory movements.
enum StockAdjustmentReason {
  PURCHASE       // New stock received from supplier
  DAMAGE         // Damaged / unsellable goods removed
  THEFT          // Shrinkage / loss
  CORRECTION     // Data-entry error fix
  RETURN         // Customer return added back to stock
  OPENING_STOCK  // Initial stock when product is created
}

/// Lifecycle of a discount voucher / coupon.
enum DiscountType {
  PERCENTAGE   // e.g. 10 % off total
  FIXED_AMOUNT // e.g. $5 off total
  BUY_X_GET_Y  // Future: promotional rules
}

/// Status of a customer return / refund.
enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

// ================  USERS  (Authentication + Role-Based Access Control)  ================

/// System users — cashiers, managers, and administrators.
/// Passwords are NEVER stored in plain text; always use bcrypt (cost ≥ 12).
model User {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @db.Text         // bcrypt hash, never the plain password
  role         Role     @default(CASHIER)
  pin          String?  @db.VarChar(6)   // Optional 6-digit quick PIN for cashier screen
  isActive     Boolean  @default(true)   // Soft-disable without deleting history
  isVerified     Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  sales           Sale[]
  stockAdjustments StockAdjustment[]
  auditLogs        AuditLog[]
  sessions         UserSession[]
  verifyEmails     VerifyEmail[]
  passwordResets   PasswordReset[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model VerifyEmail {
  id                      String    @id @default(cuid())
  userId                  String @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationCode        String?
  verificationCodeExpires DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@map("verify_emails")
}

model PasswordReset {
  id                        String    @id @default(cuid())
  userId                    String
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordResetCode        String?
  passwordResetCodeExpires DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@map("password_resets")
}

/// Persisted sessions allow server-side logout / token revocation.
/// Store the JWT jti (ID) here; the auth middleware checks it is not revoked.
model UserSession {
  id        String   @id @default(cuid())
  userId    String
  jti       String   @unique  // JWT ID — matched on every request
  issuedAt  DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?          // Set on logout
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jti])
  @@map("user_sessions")
}

// ================  PRODUCTS  ================

/// Product categories for filtering and reporting.
model Category {
  id          String    @id @default(cuid())
  name        String    @unique @db.VarChar(80)
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@index([name])
  @@map("categories")
}

/// Master product catalogue.
/// Every product gets an Inventory record (created automatically via service layer).
model Product {
  id          String   @id @default(cuid())
  productName String   @db.VarChar(150)
  sku         String?  @unique @db.VarChar(50)  // Internal stock-keeping unit
  barcode     String?  @unique @db.VarChar(50)  // EAN-13 / QR / custom barcode
  categoryId  String
  description String?  @db.Text
  imageUrl    String?  @db.Text

  // Pricing
  price       Decimal  @db.Decimal(12, 2)  // Selling price (tax-exclusive)
  costPrice   Decimal  @db.Decimal(12, 2)  // Purchase / landed cost (for profit reports)
  taxRate     Decimal  @default(0) @db.Decimal(5, 2)  // Per-product VAT %, overrides global

  isActive    Boolean  @default(true)      // Soft-delete flag
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  category         Category         @relation(fields: [categoryId], references: [id])
  inventory        Inventory?       // 1-to-1 stock record
  saleItems        SaleItem[]
  stockAdjustments StockAdjustment[]
  supplierProducts SupplierProduct[]

  @@index([productName])
  @@index([barcode])
  @@index([sku])
  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

//  ================  INVENTORY  ================

/// Real-time stock levels — one record per product.
/// Updated atomically inside prisma.$transaction when a sale is processed.
model Inventory {
  id            String    @id @default(cuid())
  productId     String    @unique
  quantity      Int       @default(0)   // Current on-hand quantity
  lowStockLevel Int       @default(10)  // Alert threshold
  reorderPoint  Int       @default(20)  // Recommended reorder quantity
  updatedAt     DateTime  @updatedAt

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockAdjustments StockAdjustment[]

  @@index([quantity])
  @@map("inventory")
}

/// Full audit trail of every stock movement (sales deductions + manual adjustments).
/// Used for inventory reports and discrepancy investigation.
model StockAdjustment {
  id          String               @id @default(cuid())
  inventoryId String
  productId   String
  userId      String               // Who performed the adjustment
  reason      StockAdjustmentReason
  quantityBefore Int
  quantityChange  Int              // Positive = added, negative = removed
  quantityAfter   Int
  notes           String?          @db.Text
  referenceId     String?          // e.g. saleId, purchaseOrderId
  createdAt       DateTime         @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
  @@map("stock_adjustments")
}

//  ================  SUPPLIERS  ================

/// Supplier / vendor master — used for purchase orders and restocking.
model Supplier {
  id           String    @id @default(cuid())
  name         String    @db.VarChar(100)
  contactName  String?   @db.VarChar(100)
  phone        String?   @db.VarChar(20)
  email        String?   @db.VarChar(150)
  address      String?   @db.Text
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  supplierProducts SupplierProduct[]
  purchaseOrders   PurchaseOrder[]

  @@index([name])
  @@map("suppliers")
}

/// Junction table — a product can have multiple suppliers with different costs.
model SupplierProduct {
  id         String  @id @default(cuid())
  supplierId String
  productId  String
  unitCost   Decimal @db.Decimal(12, 2)
  isPreferred Boolean @default(false)

  supplier Supplier @relation(fields: [supplierId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([supplierId, productId])
  @@map("supplier_products")
}

/// Purchase orders for restocking — ties supplier deliveries to inventory increases.
model PurchaseOrder {
  id          String   @id @default(cuid())
  supplierId  String
  orderDate   DateTime @default(now())
  expectedAt  DateTime?
  receivedAt  DateTime?
  notes       String?  @db.Text
  totalCost   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@index([supplierId])
  @@index([orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  productId       String  // Stored as plain reference (no FK to allow archived products)
  productName     String  @db.VarChar(150)  // Snapshot at time of order
  quantityOrdered Int
  quantityReceived Int    @default(0)
  unitCost        Decimal @db.Decimal(12, 2)
  subtotal        Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// ================  CUSTOMERS  ================

/// Registered customer profiles with loyalty point tracking.
/// Walk-in customers are represented by null customerId on a Sale.
model Customer {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(100)
  phone         String?  @unique @db.VarChar(20)
  email         String?  @unique @db.VarChar(150)
  address       String?  @db.Text
  loyaltyPoints Int      @default(0)   // Accrued points (1 point per currency unit spent)
  dateOfBirth   DateTime?
  notes         String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sales           Sale[]
  loyaltyRedemptions LoyaltyRedemption[]

  @@index([phone])
  @@index([email])
  @@index([name])
  @@map("customers")
}

/// Track when and how loyalty points are redeemed.
model LoyaltyRedemption {
  id          String   @id @default(cuid())
  customerId  String
  saleId      String
  pointsUsed  Int
  valueApplied Decimal @db.Decimal(12, 2)  // Monetary value of the redemption
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("loyalty_redemptions")
}

// ================  DISCOUNTS / COUPONS  ================

/// Configurable discount codes or automatic promotions applied at checkout.
model Discount {
  id              String       @id @default(cuid())
  code            String?      @unique @db.VarChar(30)  // null = auto-applied
  description     String       @db.VarChar(200)
  type            DiscountType
  value           Decimal      @db.Decimal(10, 2)       // % or fixed amount
  minOrderAmount  Decimal?     @db.Decimal(12, 2)       // Minimum cart value to qualify
  maxUses         Int?                                  // null = unlimited
  usedCount       Int          @default(0)
  validFrom       DateTime?
  validUntil      DateTime?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  sales Sale[]

  @@index([code])
  @@index([isActive])
  @@map("discounts")
}

//   ================  SALES  ================

/// A single sales transaction — the core business record.
/// Created with status PENDING, transitions to COMPLETED atomically with Payment.
model Sale {
  id             String     @id @default(cuid())
  userId         String                            // Cashier who processed the sale
  customerId     String?                           // null = walk-in customer
  discountId     String?                           // Applied discount/coupon
  status         SaleStatus @default(PENDING)

  // Financial summary (all stored in base currency)
  subtotal       Decimal    @db.Decimal(12, 2)     // Sum of saleItem.subtotals
  discountAmount Decimal    @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal    @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal    @db.Decimal(12, 2)     // subtotal - discount + tax

  notes          String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  user      User       @relation(fields: [userId], references: [id])
  customer  Customer?  @relation(fields: [customerId], references: [id])
  discount  Discount?  @relation(fields: [discountId], references: [id])
  saleItems SaleItem[]
  payment   Payment?
  refund    Refund?
  receipt   Receipt?

  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])              // Essential for all date-range report queries
  @@map("sales")
}

/// Line items within a sale — one row per product per transaction.
model SaleItem {
  id         String  @id @default(cuid())
  saleId     String
  productId  String
  productName String @db.VarChar(150)       // Snapshot — preserves name if product renamed
  barcode    String? @db.VarChar(50)        // Snapshot at time of sale
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)     // Snapshot of price at time of sale
  discount   Decimal @default(0) @db.Decimal(12, 2)  // Per-line discount
  taxRate    Decimal @default(0) @db.Decimal(5, 2)
  subtotal   Decimal @db.Decimal(12, 2)     // (unitPrice × quantity) − discount

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

//  ================  PAYMENTS  ================

/// One payment record per completed sale (1-to-1 with Sale).
/// Split-payment support can be added via a SalePayment join table if needed.
model Payment {
  id          String        @id @default(cuid())
  saleId      String        @unique
  method      PaymentMethod
  amountPaid  Decimal       @db.Decimal(12, 2)
  changeDue   Decimal       @default(0) @db.Decimal(12, 2)

  // External references for non-cash methods
  reference   String?       @db.VarChar(100) // Mobile-money txn ID / card auth code
  provider    String?       @db.VarChar(50)  // e.g. "M-Pesa", "Visa", "Mastercard"
  last4       String?       @db.VarChar(4)   // Last 4 digits of card (never full PAN)

  createdAt   DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([method])
  @@index([createdAt])
  @@map("payments")
}

//  ================  RECEIPTS  ================

/// Stored receipt data — supports reprint and digital delivery.
/// Generated server-side after a sale is COMPLETED.
model Receipt {
  id              String   @id @default(cuid())
  saleId          String   @unique
  receiptNumber   String   @unique @db.VarChar(30)  // Human-readable: RCP-20240309-0001
  storeName       String   @db.VarChar(100)
  storeAddress    String?  @db.Text
  storeTaxId      String?  @db.VarChar(30)          // VAT / TIN number for tax receipts
  cashierName     String   @db.VarChar(100)
  customerName    String?  @db.VarChar(100)
  printedAt       DateTime?
  emailedAt       DateTime?
  createdAt       DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([receiptNumber])
  @@index([createdAt])
  @@map("receipts")
}

//  ================  REFUNDS  ================

/// Tracks refund requests and their approval / rejection workflow.
model Refund {
  id          String       @id @default(cuid())
  saleId      String       @unique
  requestedBy String                         // userId of the cashier / manager
  approvedBy  String?                        // userId of the manager who approved
  status      RefundStatus @default(REQUESTED)
  reason      String       @db.Text
  refundAmount Decimal     @db.Decimal(12, 2)
  refundMethod PaymentMethod
  processedAt DateTime?
  notes       String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("refunds")
}

//  ================  REPORTING SUPPORT TABLES  ================

/// Daily aggregated sales snapshot — pre-computed for fast dashboard queries.
/// Populated by a scheduled job (cron) at end of each business day.
model DailySalesSnapshot {
  id              String   @id @default(cuid())
  date            DateTime @unique @db.Date    // The business day
  totalTransactions Int
  totalRevenue    Decimal  @db.Decimal(14, 2)
  totalDiscount   Decimal  @db.Decimal(14, 2)
  totalTax        Decimal  @db.Decimal(14, 2)
  totalCost       Decimal  @db.Decimal(14, 2)  // COGS for gross profit calculation
  grossProfit     Decimal  @db.Decimal(14, 2)
  cashSales       Decimal  @db.Decimal(14, 2)
  mobileMoneySales Decimal @db.Decimal(14, 2)
  cardSales       Decimal  @db.Decimal(14, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
  @@map("daily_sales_snapshots")
}

//  ================  HARDWARE INTEGRATION  ================

/// Registered POS terminal devices (barcode scanners, receipt printers, etc.)
model HardwareDevice {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(100)   // e.g. "Cashier 1 Printer"
  type         String   @db.VarChar(50)    // "BARCODE_SCANNER" | "RECEIPT_PRINTER" | "CASH_DRAWER" | "CARD_READER"
  serialNumber String?  @db.VarChar(100)
  ipAddress    String?  @db.VarChar(45)
  port         Int?
  isOnline     Boolean  @default(false)
  lastSeenAt   DateTime?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type])
  @@map("hardware_devices")
}

//  ================  SECURITY & AUDIT  ================
/// Immutable audit trail — every sensitive write operation appends a row here.
/// NEVER update or delete from this table.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?                        // null if system/anonymous action
  action     String   @db.VarChar(60)       // e.g. "VOID_SALE", "ADJUST_STOCK", "DELETE_PRODUCT"
  targetType String   @db.VarChar(50)       // e.g. "Sale", "Product", "User"
  targetId   String   @db.VarChar(50)
  before     Json?                          // Snapshot of record BEFORE change
  after      Json?                          // Snapshot of record AFTER change
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Store settings — key/value pairs for runtime configuration
/// (store name, currency, tax rate, loyalty ratio, etc.)
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(80)
  value     String   @db.Text
  group     String   @db.VarChar(40)    // e.g. "store", "tax", "loyalty", "receipt"
  label     String   @db.VarChar(100)   // Human-readable label for admin UI
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("settings")
}
